{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["tsconfig.json", "tsconfig.base.json"],
	"globalPassThroughEnv": [
		"APP_ORIGIN",
		"DATABASE_URL",
		"WORKER_DATABASE_URL",
		"MIGRATION_DATABASE_URL",
		"MIGRATIONS_DIR",
		"WORKER_HEARTBEAT_PATH",
		"PORT",
		"HOSTNAME",
		"OPENFGA_URL",
		"OPENFGA_API_URL",
		"S3_ENDPOINT",
		"S3_ACCESS_KEY_ID",
		"S3_SECRET_ACCESS_KEY",
		"MAILPIT_HTTP_URL",
		"AUTHZ_PUBLISH_TOKEN",
		"TEST_DATABASE_ADMIN_URL",
		"TEST_IMAGE",
		"PLAYWRIGHT_BASE_URL",
		"E2E_REPORT_GROUP",
		"CI",
		"VITEST_REPORT",
		"TRIVY_BIN",
		"NEXT_RUNTIME",
		"NEXT_PHASE",
		"IDENTITY_DATABASE_URL",
		"CONTROL_DATABASE_URL",
		"CONTROL_ADMIN_DATABASE_URL",
		"INSTALLATION_ID",
		"AUTH_SECRET",
		"SMTP_HOST",
		"SMTP_PORT",
		"SMTP_FROM",
		"OWNER_RECOVERY_PUBLIC_KEY",
		"TEST_CONTROL_ADMIN_URL",
		"SMTP_PASSWORD",
		"SMTP_SECURE",
		"SMTP_USERNAME",
		"BILLING_ENABLED",
		"STRIPE_SECRET_KEY",
		"STRIPE_WEBHOOK_SECRET",
		"STRIPE_ACCOUNT_ID",
		"STRIPE_PORTAL_CONFIGURATION_ID",
		"STRIPE_MODE",
		"DEFAULT_PROJECT_CREATES_PER_MONTH",
		"USAGE_NOTICE_THRESHOLDS"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"],
			"env": ["PHASE0_API_FIXTURES", "NODE_ENV", "NEXT_TELEMETRY_DISABLED"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"storybook:build": {
			"cache": false
		}
	}
}
