{
	"name": "common-sass",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": ">=24.19.0 <25"
	},
	"workspaces": [
		"spikes/phase0/api-next",
		"spikes/phase0/contracts",
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"phase0:test": "node node_modules/vitest/vitest.mjs run --config vitest.phase0.config.ts",
		"phase0:typecheck": "node node_modules/typescript/bin/tsc --noEmit",
		"phase0:build": "node node_modules/turbo/bin/turbo run build --filter=@common-sass/phase0-api",
		"phase0:services:up": "docker compose -f spikes/phase0/compose.yaml up -d --wait",
		"phase0:services:down": "docker compose -f spikes/phase0/compose.yaml down",
		"phase0:test:integration": "PHASE0_INTEGRATION=1 node node_modules/vitest/vitest.mjs run --config vitest.phase0.config.ts",
		"phase0:api:smoke": "node --import tsx scripts/phase0/api-smoke.ts",
		"phase0:storybook": "node node_modules/storybook/dist/bin/dispatcher.js build --config-dir spikes/phase0/api-next/.storybook --output-dir artifacts/phase0-storybook --disable-telemetry",
		"phase0:browser": "node node_modules/@playwright/test/cli.js test --config spikes/phase0/api-next/playwright.config.ts",
		"phase0:toolchain": "node --import tsx scripts/phase0/toolchain.ts",
		"phase0:authz:smoke": "node --import tsx spikes/phase0/authz/benchmark.ts --contextual --smoke",
		"phase0:authz:benchmark": "node --import tsx spikes/phase0/authz/benchmark.ts --contextual",
		"phase0:authz:contextual": "node --import tsx spikes/phase0/authz/benchmark.ts --contextual",
		"phase0:authz:legacy": "node --import tsx spikes/phase0/authz/benchmark.ts",
		"dev": "node --env-file-if-exists=.env --import tsx scripts/phase1/dev.ts",
		"build": "node node_modules/turbo/bin/turbo run build --filter=@common-saas/web && node --import tsx scripts/phase1/build-runtime.ts",
		"check": "node node_modules/@biomejs/biome/bin/biome ci .",
		"format": "node node_modules/@biomejs/biome/bin/biome check --write .",
		"typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc --noEmit -p apps/web/tsconfig.json",
		"commitlint": "node node_modules/@commitlint/cli/cli.js",
		"knip": "node node_modules/knip/bin/knip.js",
		"hooks:install": "node node_modules/lefthook/bin/index.js install",
		"test:unit": "node node_modules/vitest/vitest.mjs run --project unit",
		"test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project integration",
		"test:e2e": "node node_modules/@playwright/test/cli.js test",
		"storybook": "node node_modules/storybook/dist/bin/dispatcher.js dev --port 6006 --config-dir apps/web/.storybook",
		"storybook:build": "node node_modules/storybook/dist/bin/dispatcher.js build --config-dir apps/web/.storybook --output-dir artifacts/storybook --disable-telemetry",
		"authz:validate": "node --env-file-if-exists=.env --import tsx scripts/phase1/authz-validate.ts",
		"authz:benchmark": "node --env-file-if-exists=.env --import tsx scripts/phase3/benchmark.ts",
		"authz:smoke": "node --env-file-if-exists=.env --import tsx scripts/phase3/benchmark.ts --smoke",
		"skills:check": "node --env-file-if-exists=.env --import tsx scripts/phase4/check.ts",
		"skills:evaluate": "node --import tsx scripts/phase4/evaluate.ts",
		"security:scan": "node --import tsx scripts/phase1/security-scan.ts",
		"services:up": "docker compose -f infra/compose.yaml up -d --wait && node --env-file-if-exists=.env --import tsx scripts/phase1/services-ready.ts",
		"services:down": "docker compose -f infra/compose.yaml down",
		"db:migrate": "node --env-file-if-exists=.env --import tsx scripts/phase1/command.ts migrate",
		"db:test:upgrade": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project integration packages/db",
		"test:image": "node --import tsx scripts/phase1/image-test.ts",
		"worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/index.ts",
		"image:build": "node --import tsx scripts/phase1/image-build.ts",
		"bootstrap": "node --env-file-if-exists=.env --import tsx scripts/phase1/command.ts bootstrap",
		"authz:upgrade": "node --env-file-if-exists=.env --import tsx scripts/phase1/command.ts authz-upgrade",
		"authz:publish": "node --env-file-if-exists=.env --import tsx scripts/phase1/command.ts authz-publish",
		"owner:recover": "node --env-file-if-exists=.env --import tsx scripts/phase1/command.ts owner-recovery",
		"security:deactivate": "node --env-file-if-exists=.env --import tsx scripts/phase1/command.ts security-deactivate"
	},
	"devDependencies": {
		"next": "16.3.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"better-auth": "1.7.5",
		"@better-auth/passkey": "1.7.5",
		"shadcn": "4.21.0",
		"typescript": "7.0.2",
		"drizzle-orm": "0.45.3",
		"drizzle-kit": "0.31.11",
		"@orpc/server": "1.15.3",
		"@orpc/client": "1.15.3",
		"stripe": "22.6.2",
		"tailwindcss": "4.3.3",
		"next-intl": "4.14.6",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.1.0",
		"react-email": "6.9.5",
		"zod": "4.6.5",
		"react-hook-form": "7.88.0",
		"@hookform/resolvers": "5.9.1",
		"vitest": "5.0.1",
		"@playwright/test": "1.63.0",
		"storybook": "10.6.0",
		"@storybook/nextjs-vite": "10.6.0",
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"lefthook": "2.1.14",
		"knip": "6.37.0",
		"@t3-oss/env-nextjs": "0.13.11",
		"@t3-oss/env-core": "0.13.11",
		"turbo": "2.11.2",
		"pg": "8.23.0",
		"pg-boss": "12.33.4",
		"@openfga/sdk": "0.9.7",
		"posthog-node": "5.52.5",
		"@aws-sdk/client-s3": "3.1137.0",
		"@aws-sdk/s3-request-presigner": "3.1137.0",
		"@types/node": "24.10.1",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"tsx": "4.23.15",
		"@better-auth/scim": "1.7.5",
		"@better-auth/sso": "1.7.5",
		"esbuild": "0.28.2",
		"@common-saas/config": "workspace:*",
		"@common-saas/db": "workspace:*",
		"@common-saas/observability": "workspace:*",
		"@common-saas/authz": "workspace:*",
		"@common-saas/email": "workspace:*"
	},
	"trustedDependencies": [
		"esbuild",
		"sharp"
	]
}
