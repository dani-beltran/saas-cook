{
	"name": "common-sass",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": ">=24.19.0 <25"
	},
	"workspaces": [
		"spikes/phase0/api-next",
		"spikes/phase0/contracts"
	],
	"scripts": {
		"phase0:test": "node node_modules/vitest/vitest.mjs run",
		"phase0:typecheck": "node node_modules/typescript/bin/tsc --noEmit",
		"phase0:build": "node node_modules/turbo/bin/turbo run build",
		"phase0:services:up": "docker compose -f spikes/phase0/compose.yaml up -d --wait",
		"phase0:services:down": "docker compose -f spikes/phase0/compose.yaml down",
		"phase0:test:integration": "PHASE0_INTEGRATION=1 node node_modules/vitest/vitest.mjs run",
		"phase0:api:smoke": "node --import tsx scripts/phase0/api-smoke.ts",
		"phase0:storybook": "node node_modules/storybook/dist/bin/dispatcher.js build --config-dir spikes/phase0/api-next/.storybook --output-dir artifacts/phase0-storybook --disable-telemetry",
		"phase0:browser": "node node_modules/@playwright/test/cli.js test --config spikes/phase0/api-next/playwright.config.ts",
		"phase0:toolchain": "node --import tsx scripts/phase0/toolchain.ts",
		"phase0:authz:smoke": "node --import tsx spikes/phase0/authz/benchmark.ts --contextual --smoke",
		"phase0:authz:benchmark": "node --import tsx spikes/phase0/authz/benchmark.ts --contextual",
		"phase0:authz:contextual": "node --import tsx spikes/phase0/authz/benchmark.ts --contextual",
		"phase0:authz:legacy": "node --import tsx spikes/phase0/authz/benchmark.ts"
	},
	"devDependencies": {
		"next": "16.3.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"better-auth": "1.7.5",
		"@better-auth/passkey": "1.7.5",
		"shadcn": "4.21.0",
		"typescript": "7.0.2",
		"drizzle-orm": "0.45.3",
		"drizzle-kit": "0.31.11",
		"@orpc/server": "1.15.3",
		"@orpc/client": "1.15.3",
		"@orpc/openapi": "1.15.3",
		"@orpc/zod": "1.15.3",
		"stripe": "22.6.2",
		"tailwindcss": "4.3.3",
		"@tailwindcss/postcss": "4.3.3",
		"next-intl": "4.14.6",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.1.0",
		"react-email": "6.9.5",
		"zod": "4.6.5",
		"react-hook-form": "7.88.0",
		"@hookform/resolvers": "5.9.1",
		"vitest": "5.0.1",
		"@playwright/test": "1.63.0",
		"storybook": "10.6.0",
		"@storybook/nextjs-vite": "10.6.0",
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"lefthook": "2.1.14",
		"knip": "6.37.0",
		"@t3-oss/env-nextjs": "0.13.11",
		"@t3-oss/env-core": "0.13.11",
		"@logtape/logtape": "2.3.7",
		"turbo": "2.11.2",
		"pg": "8.23.0",
		"pg-boss": "12.33.4",
		"@openfga/sdk": "0.9.7",
		"posthog-node": "5.52.5",
		"@aws-sdk/client-s3": "3.1137.0",
		"@aws-sdk/s3-request-presigner": "3.1137.0",
		"@types/node": "24.10.1",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"tsx": "4.23.15",
		"@orpc/contract": "1.15.3",
		"@better-auth/scim": "1.7.5",
		"@better-auth/sso": "1.7.5"
	},
	"trustedDependencies": [
		"esbuild",
		"sharp"
	]
}
