# Synthetic, disposable local services only. Copy to .env for local commands.
APP_ORIGIN=http://localhost:3000
APP_NAME="SaaS Cook"
DEFAULT_LOCALE=en
DATABASE_URL=postgres://saas_cook_web:local_phase1@127.0.0.1:55433/saas_cook
WORKER_DATABASE_URL=postgres://saas_cook_worker:local_phase1@127.0.0.1:55433/saas_cook
IDENTITY_DATABASE_URL=postgres://saas_cook_identity:local_phase1@127.0.0.1:55433/saas_cook
AUTH_SECRET=local_phase2_synthetic_secret_not_for_production_0001
# Production ingress: set a separate AUTH_INGRESS_SECRET and sign source metadata.
# See docs/phase2/README.md. Omitted locally: all requests share one source limit.
INSTALLATION_ID=10000000-0000-4000-8000-000000000001
CONTROL_DATABASE_URL=postgres://saas_cook_control_reader:local_phase2_control@127.0.0.1:55434/saas_cook_control
CONTROL_ADMIN_DATABASE_URL=postgres://saas_cook_control_admin:local_phase2_control@127.0.0.1:55434/saas_cook_control
MIGRATION_DATABASE_URL=postgres://saas_cook_migrator:local_phase1@127.0.0.1:55433/saas_cook
TEST_DATABASE_ADMIN_URL=postgres://postgres:local_phase1@127.0.0.1:55433/postgres
OPENFGA_API_URL=http://127.0.0.1:18081
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=security@example.test
SMTP_SECURE=false
# SMTP_USERNAME and SMTP_PASSWORD require SMTP_SECURE=true (implicit TLS).
S3_ENDPOINT=http://127.0.0.1:19000
S3_ACCESS_KEY_ID=local_phase1
S3_SECRET_ACCESS_KEY=local_phase1_storage
# Never give MIGRATION_DATABASE_URL to the serve image. Only to migrate.

# Phase 3 server-only local entitlement preset (billing providers disabled).
DEFAULT_PROJECT_CAPACITY=100
# DEFAULT_PROJECT_CAPACITY=unlimited explicitly allows unbounded project capacity.

# Phase 5: local usage enforcement works with Stripe disabled.
BILLING_ENABLED=false
DEFAULT_PROJECT_CREATES_PER_MONTH=1000
USAGE_NOTICE_THRESHOLDS=80,95,100
# Enabling Stripe requires every value below. Never use live credentials in tests.
STRIPE_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_ACCOUNT_ID=acct_...
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
# Use API/event version 2026-08-26.dahlia; disable portal subscription updates/cancellation.

# Optional private UTF-8 text/CSV files; configure the bucket/IAM/CORS from docs/phase6/files.md.
FILES_ENABLED=false
FILES_CAPACITY_BYTES=52428800
FILES_S3_REGION=us-east-1
# FILES_S3_ENDPOINT=https://your-compatible-storage.example
# FILES_S3_BUCKET=your-private-versioned-bucket
# FILES_S3_UPLOAD_KEY=staging-only-access-key
# FILES_S3_UPLOAD_SECRET=configure-at-runtime
# FILES_S3_FINALIZER_KEY=trusted-finalizer-access-key
# FILES_S3_FINALIZER_SECRET=configure-at-runtime

# Phase 6 completion. These modules are opt-in; database roles are separate.
PLATFORM_ENABLED=false
APP_ENV=development
# Required when PLATFORM_ENABLED=true. Local test passwords only:
# LIFECYCLE_DATABASE_URL=postgres://saas_cook_lifecycle:local_phase1@127.0.0.1:55433/saas_cook
# JOURNAL_DATABASE_URL=postgres://saas_cook_journal_writer:local_phase2_control@127.0.0.1:55434/saas_cook_control
# Bulk jobs also require FILES_ENABLED and its versioned storage credentials.
# Exact public HTTPS destination hostnames; empty disables outgoing destinations.
OUTGOING_ALLOWED_HOSTS=
ANALYTICS_ENABLED=false
POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PROJECT_ID=123
# POSTHOG_TOKEN=configure-project-ingestion-token
# POSTHOG_PERSONAL_KEY=configure-restricted-query-person-deletion-key
# Keep provider cleanup credentials configured when collection is disabled.
# OPTIONAL_EMAIL_FEEDBACK_SECRET=configure-independent-32-character-minimum-secret
# Commands only; NEVER inject the following into serve/web/worker:
# RECOVERY_DATABASE_URL=postgres://saas_cook_recovery:local_phase1@127.0.0.1:55433/saas_cook
# PLATFORM_OPERATOR_DATABASE_URL=postgres://saas_cook_platform_operator:local_phase1@127.0.0.1:55433/saas_cook
# RECOVERY_PUBLIC_KEY=independently-managed-Ed25519-public-key-PEM
# Setup, role provisioning and recovery approvals: docs/phase6/recovery.md.

# Optional Backoffice: omit all BO values for customer-only deployments.
# Use independent credentials and keys; never reuse AUTH_SECRET or customer cookies.
# BACKOFFICE_ORIGIN=http://localhost:3001
# BACKOFFICE_ENVIRONMENT=development
# BACKOFFICE_AUTH_SECRET=<independent 32+ character secret>
# BACKOFFICE_IDENTITY_DATABASE_URL=postgres://saas_cook_bo_identity:local_phase1@127.0.0.1:55433/saas_cook
# BACKOFFICE_DATABASE_URL=postgres://saas_cook_bo_query:local_phase1@127.0.0.1:55433/saas_cook
# Management command only; never inject these into the BO web process:
# BACKOFFICE_MANAGEMENT_DATABASE_URL=postgres://saas_cook_bo_manager:local_phase1@127.0.0.1:55433/saas_cook
# BACKOFFICE_SPONSOR_PUBLIC_KEY_FILE=/private/path/sponsor-public.pem
# BACKOFFICE_SECURITY_PUBLIC_KEY_FILE=/private/path/security-public.pem
