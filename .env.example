# Synthetic, disposable local services only. Copy to .env for local commands.
APP_ORIGIN=http://localhost:3000
APP_NAME=common-sass
DEFAULT_LOCALE=en
DATABASE_URL=postgres://common_saas_web:local_phase1@127.0.0.1:55433/common_saas
WORKER_DATABASE_URL=postgres://common_saas_worker:local_phase1@127.0.0.1:55433/common_saas
MIGRATION_DATABASE_URL=postgres://common_saas_migrator:local_phase1@127.0.0.1:55433/common_saas
TEST_DATABASE_ADMIN_URL=postgres://postgres:local_phase1@127.0.0.1:55433/postgres
OPENFGA_API_URL=http://127.0.0.1:18081
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
S3_ENDPOINT=http://127.0.0.1:19000
S3_ACCESS_KEY_ID=local_phase1
S3_SECRET_ACCESS_KEY=local_phase1_storage
# Never give MIGRATION_DATABASE_URL to the serve image. Only to migrate.
