# Synthetic, disposable local services only. Copy to .env for local commands.
APP_ORIGIN=http://localhost:3000
APP_NAME="SaaS Cook"
DEFAULT_LOCALE=en
DATABASE_URL=postgres://saas_cook_web:local_phase1@127.0.0.1:55433/saas_cook
WORKER_DATABASE_URL=postgres://saas_cook_worker:local_phase1@127.0.0.1:55433/saas_cook
IDENTITY_DATABASE_URL=postgres://saas_cook_identity:local_phase1@127.0.0.1:55433/saas_cook
AUTH_SECRET=local_phase2_synthetic_secret_not_for_production_0001
# Production ingress: set a separate AUTH_INGRESS_SECRET and sign source metadata.
# See docs/phase2/README.md. Omitted locally: all requests share one source limit.
INSTALLATION_ID=10000000-0000-4000-8000-000000000001
CONTROL_DATABASE_URL=postgres://saas_cook_control_reader:local_phase2_control@127.0.0.1:55434/saas_cook_control
CONTROL_ADMIN_DATABASE_URL=postgres://saas_cook_control_admin:local_phase2_control@127.0.0.1:55434/saas_cook_control
MIGRATION_DATABASE_URL=postgres://saas_cook_migrator:local_phase1@127.0.0.1:55433/saas_cook
TEST_DATABASE_ADMIN_URL=postgres://postgres:local_phase1@127.0.0.1:55433/postgres
OPENFGA_API_URL=http://127.0.0.1:18081
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=security@example.test
SMTP_SECURE=false
# SMTP_USERNAME and SMTP_PASSWORD require SMTP_SECURE=true (implicit TLS).
S3_ENDPOINT=http://127.0.0.1:19000
S3_ACCESS_KEY_ID=local_phase1
S3_SECRET_ACCESS_KEY=local_phase1_storage
# Never give MIGRATION_DATABASE_URL to the serve image. Only to migrate.

# Phase 3 server-only local entitlement preset (billing providers disabled).
DEFAULT_PROJECT_CAPACITY=100
# DEFAULT_PROJECT_CAPACITY=unlimited explicitly allows unbounded project capacity.

# Phase 5: local usage enforcement works with Stripe disabled.
BILLING_ENABLED=false
DEFAULT_PROJECT_CREATES_PER_MONTH=1000
USAGE_NOTICE_THRESHOLDS=80,95,100
# Enabling Stripe requires every value below. Never use live credentials in tests.
STRIPE_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_ACCOUNT_ID=acct_...
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
# Use API/event version 2026-08-26.dahlia; disable portal subscription updates/cancellation.

# Optional private UTF-8 text/CSV files; configure the bucket/IAM/CORS from docs/phase6/files.md.
FILES_ENABLED=false
FILES_CAPACITY_BYTES=52428800
FILES_S3_REGION=us-east-1
# FILES_S3_ENDPOINT=https://your-compatible-storage.example
# FILES_S3_BUCKET=your-private-versioned-bucket
# FILES_S3_UPLOAD_KEY=staging-only-access-key
# FILES_S3_UPLOAD_SECRET=configure-at-runtime
# FILES_S3_FINALIZER_KEY=trusted-finalizer-access-key
# FILES_S3_FINALIZER_SECRET=configure-at-runtime
