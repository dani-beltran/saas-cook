{
	"name": "@saas-cook/web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node ../../node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
		"build": "node ../../node_modules/next/dist/bin/next build --webpack && node scripts/package-assets.mjs",
		"start": "node .next/standalone/apps/web/server.js",
		"typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
		"storybook": "node ../../node_modules/storybook/dist/bin/dispatcher.js dev --port 6006 --config-dir .storybook --disable-telemetry",
		"storybook:build": "node ../../node_modules/storybook/dist/bin/dispatcher.js build --config-dir .storybook --output-dir ../../artifacts/storybook --disable-telemetry"
	},
	"dependencies": {
		"sharp": "0.35.5",
		"@saas-cook/api": "workspace:*",
		"@saas-cook/config": "workspace:*",
		"@saas-cook/observability": "workspace:*",
		"@saas-cook/ui": "workspace:*",
		"next": "16.4.1",
		"next-intl": "4.14.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"@saas-cook/db": "workspace:*",
		"@saas-cook/api-contracts": "workspace:*",
		"better-auth": "1.7.5",
		"@better-auth/passkey": "1.7.5",
		"react-hook-form": "7.88.0",
		"@hookform/resolvers": "5.9.1",
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@storybook/nextjs-vite": "10.6.2",
		"@tailwindcss/postcss": "4.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"storybook": "10.6.2",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2"
	}
}
